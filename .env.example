# ==============================================================================
# KRIYA Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local parameters.
# Ports 8000 and 8080 are reserved for external model gateways / inference nodes.
# ==============================================================================

# Local / Sovereign LLM Endpoint (OpenAI-compatible server: llama-server, vLLM, Ollama)
MODEL_BALANCER_URL=http://localhost:8080/v1
MODEL_BALANCER_KEY=local-key

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres@localhost:5432/kriya_db

# Service Ports
BACKEND_PORT=5000
FRONTEND_PORT=3000
