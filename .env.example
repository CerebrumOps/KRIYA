# ==============================================================================
# KRIYA Sovereign AI Client Appliance — Configuration Template (.env.example)
# ==============================================================================

# ── Enterprise Auth Gateway (sih_backend) ───────────────────────────────────
AUTH_BACKEND_URL=http://localhost:5000
VITE_AUTH_BACKEND_URL=http://localhost:5000

# ── Local Client Appliance Agent API ─────────────────────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT=5001
VITE_BACKEND_URL=http://localhost:5001

# ── Frontend Web UI ─────────────────────────────────────────────────────────
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# ── Model Balancer (Raspberry Pi 5 via Tailscale) ────────────────────────────
MODEL_BALANCER_URL=http://100.127.46.50:8000/v1
MODEL_BALANCER_API_KEY=sih2026
DEFAULT_MODEL=llama3.2:3b-instruct-q8_0

# ── Company FastMCP Telemetry Server (Raspberry Pi 5) ─────────────────────────
REMOTE_MCP_URL=http://100.127.46.50:8085

# ── Local Storage Directories (Inside Container) ────────────────────────────
DATA_DIR=/app/data
WORKSPACE_DIR=/app/workspace
HOST_BRIDGE_DIR=/host-bridge

# ── Security & Air-Gap Controls ─────────────────────────────────────────────
JWT_SECRET=kriya_sovereign_airgap_secret_2026_mrpl
INTERNET_ENABLED=false
